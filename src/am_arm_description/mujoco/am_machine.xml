<mujoco model="6dof_additive_manufacturing_machine">
    <compiler coordinate="local" inertiafromgeom="true"/>
    <option timestep="0.001" gravity="0 0 -9.81"/> <!-- 1kHz control execution rate -->

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="512" height="512"/>
        <material name="grid_mat" texture="grid" texrepeat="1 1"/>
    </asset>

    <worldbody>
        <geom name="floor" type="plane" size="0 0 .25" material="grid_mat"/>
        <light directional="false" diffuse=".8 .8 .8" pos="0 0 4" dir="0 0 -1"/>

        <!-- Static Print Bed Substrate Plate -->
        <body name="print_bed" pos="0.5 0 0.05">
            <geom name="bed_plate" type="box" size="0.25 0.25 0.02" rgba="0.3 0.3 0.3 1"/>
        </body>

        <!-- 6-DOF Robotic Manipulator Rig -->
        <body name="base_link" pos="0 0 0.1">
            <geom name="base_geom" type="cylinder" size="0.12 0.1" rgba="0.5 0.5 0.5 1"/>
            
            <!-- Joint 1: Waist Base Rotation -->
            <body name="link1" pos="0 0 0.1">
                <joint name="joint1" type="hinge" axis="0 0 1" range="-180 180"/>
                <geom type="capsule" fromto="0 0 0 0 0 0.25" size="0.04" rgba="0.1 0.3 0.8 1"/>
                
                <!-- Joint 2: Shoulder Pitch -->
                <body name="link2" pos="0 0 0.25">
                    <joint name="joint2" type="hinge" axis="0 1 0" range="-90 90"/>
                    <geom type="capsule" fromto="0 0 0 0 0 0.3" size="0.035" rgba="0.2 0.6 0.2 1"/>
                    
                    <!-- Joint 3: Elbow Pitch -->
                    <body name="link3" pos="0 0 0.3">
                        <joint name="joint3" type="hinge" axis="0 1 0" range="-120 120"/>
                        <geom type="capsule" fromto="0 0 0 0 0 0.25" size="0.03" rgba="0.8 0.2 0.2 1"/>
                        
                        <!-- Joint 4: Forearm Roll -->
                        <body name="link4" pos="0 0 0.25">
                            <joint name="joint4" type="hinge" axis="0 0 1" range="-150 150"/>
                            <geom type="capsule" fromto="0 0 0 0 0 0.15" size="0.025" rgba="0.7 0.7 0.1 1"/>
                            
                            <!-- Joint 5: Wrist Pitch -->
                            <body name="link5" pos="0 0 0.15">
                                <joint name="joint5" type="hinge" axis="0 1 0" range="-100 100"/>
                                <geom type="capsule" fromto="0 0 0 0 0 0.1" size="0.022" rgba="0.1 0.7 0.7 1"/>
                                
                                <!-- Joint 6: Wrist Roll -->
                                <body name="link6" pos="0 0 0.1">
                                    <joint name="joint6" type="hinge" axis="0 0 1" range="-180 180"/>
                                    
                                    <!-- Printhead End Effector / Material Extruder Assembly -->
                                    <body name="printhead" pos="0 0 0.05">
                                        <geom name="extruder_body" type="box" size="0.03 0.03 0.04" rgba="0.2 0.2 0.2 1"/>
                                        <geom name="nozzle_tip" type="cone" pos="0 0 -0.05" size="0.008 0.01" rgba="0.9 0.6 0.1 1"/>
                                        <site name="deposition_point" pos="0 0 -0.06" size="0.002" rgba="1 0 0 1"/>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- Closed-Loop Position Servo Actuators -->
    <actuator>
        <position name="servo1" joint="joint1" kp="800" ctrlrange="-3.14 3.14"/>
        <position name="servo2" joint="joint2" kp="1000" ctrlrange="-1.57 1.57"/>
        <position name="servo3" joint="joint3" kp="600" ctrlrange="-2.09 2.09"/>
        <position name="servo4" joint="joint4" kp="400" ctrlrange="-2.61 2.61"/>
        <position name="servo5" joint="joint5" kp="300" ctrlrange="-1.74 1.74"/>
        <position name="servo6" joint="joint6" kp="200" ctrlrange="-3.14 3.14"/>
    </actuator>
</mujoco>
